# Production settings for docker-compose.prod.yml
# Copy to .env on the server (same folder as docker-compose.prod.yml). Never commit .env.

# Public URL of the app (the API matches it against the request Origin)
APP_ORIGIN=https://custoro.example.com
# Host port nginx listens on (put a TLS proxy in front of it)
WEB_PORT=80

# Database
DB_NAME=custoro
DB_USERNAME=custoro
DB_PASSWORD=
DB_ROOT_PASSWORD=
# TLS to the database, only needed for a database outside this Docker network. See
# apps/api/.env.production.example for DB_SSL (verify/off) and DB_SSL_CA.
# DB_SSL=

# Auth - generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Outgoing email (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Error tracking (optional)
SENTRY_DSN=

# Login and password reset limits (optional). Defaults: 10 failed logins per account and 50 per
# client address in 15 minutes; 3 reset emails per account and 10 per address per hour.
# LOGIN_MAX_FAILURES_PER_ACCOUNT=
# LOGIN_MAX_FAILURES_PER_IP=
# RESET_MAX_REQUESTS_PER_ACCOUNT=
# RESET_MAX_REQUESTS_PER_IP=
# Which proxies may report the client address in X-Forwarded-For (Express "trust proxy").
# The default trusts private-network hops, which fits a TLS proxy on the same host or network.
# If your TLS proxy reaches the server from a public address, set the hop count, e.g. 2.
# TRUST_PROXY=

# Prebuilt images (optional) - e.g. ghcr.io/<owner>/custoro-api:latest
# API_IMAGE=
# WEB_IMAGE=
