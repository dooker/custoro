# Production settings for docker-compose.prod.yml
# Copy to .env on the server (same folder as docker-compose.prod.yml). Never commit .env.

# Public URL of the app (used for CORS and for the links in emails)
APP_ORIGIN=https://custoro.example.com
# Host port nginx listens on (put a TLS proxy in front of it)
WEB_PORT=80
# REQUIRED. How many proxies stand between the internet and the API, counting nginx (the web
# container). It decides which client address the login and password reset limits count:
#   1 = people reach nginx directly (an office network, or WEB_PORT open to the internet)
#   2 = a TLS proxy (Caddy, Traefik, a load balancer, ...) sits in front of nginx
# Too high and a client can forge its address with an X-Forwarded-For header, which sidesteps the
# per-address limits and lets anyone lock an account out; too low and every visitor shares the
# proxy's address. Express "trust proxy" also accepts a list of addresses, see apps/api/index.ts.
TRUST_PROXY=

# Database
DB_NAME=custoro
DB_USERNAME=custoro
DB_PASSWORD=
DB_ROOT_PASSWORD=
# TLS to the database, only needed for a database outside this Docker network. See
# apps/api/.env.production.example for DB_SSL (verify/off) and DB_SSL_CA.
# DB_SSL=

# Auth - generate with: openssl rand -hex 32. The API refuses to start in production with a
# secret shorter than 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Outgoing email (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
# The sender, e.g. "Custoro <billing@example.com>". Empty: the mail server login when it is an
# address. Neither gives emails without a sender, which many mail servers refuse
EMAIL_FROM=
# The mail server login is only sent over TLS (STARTTLS, or TLS from the start on port 465); the
# connection fails if the server does not offer it. Leave this unset. Only for a mail server or
# test mail catcher on the same machine, "false" allows a plain connection.
# EMAIL_REQUIRE_TLS=

# Encrypts the mail server password saved on the admin settings page (AES-256-GCM). Without it the
# password is stored as plain text in the storage folder, and so in every backup of it. Generate
# with: openssl rand -hex 32. Keep it with these settings, not with the backups: a backup is then
# no use without it. If it is lost, the admin saves the mail password again; nothing else is lost.
MAIL_SETTINGS_KEY=

# Error tracking (optional). In production a tenth of the traces are sent; change that with
# SENTRY_TRACES_SAMPLE_RATE (0 to 1).
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=
# Error tracking in the browser: the DSN of a separate browser project. It is built into the web
# image (rebuild after changing it) and visible to every visitor, which is how Sentry means it.
# The prebuilt images of a release have none
WEB_SENTRY_DSN=

# Login and password reset limits (optional). Defaults, per 15 minutes: 10 failed logins per
# account from one client address, 50 per account from all addresses together, and 50 per client
# address across accounts; per hour, 3 reset emails per account from one client address, 10 per
# account from all addresses together and 10 per address across accounts. An IPv6 client counts as
# its whole /64.
# LOGIN_MAX_FAILURES_PER_ACCOUNT_ADDRESS=
# LOGIN_MAX_FAILURES_PER_ACCOUNT=
# LOGIN_MAX_FAILURES_PER_IP=
# RESET_MAX_REQUESTS_PER_ACCOUNT_ADDRESS=
# RESET_MAX_REQUESTS_PER_ACCOUNT=
# RESET_MAX_REQUESTS_PER_IP=

# Prebuilt images (optional) - e.g. ghcr.io/<owner>/custoro-api:latest
# API_IMAGE=
# WEB_IMAGE=
