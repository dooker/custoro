# Production settings for docker-compose.prod.yml
# Copy to .env on the server (same folder as docker-compose.prod.yml). Never commit .env.

# Public URL of the app (the API matches it against the request Origin)
APP_ORIGIN=https://custoro.example.com
# Host port nginx listens on (put a TLS proxy in front of it)
WEB_PORT=80

# Database
DB_NAME=custoro
DB_USERNAME=custoro
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Auth - generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Outgoing email (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Error tracking (optional)
SENTRY_DSN=

# Prebuilt images (optional) - e.g. ghcr.io/<owner>/custoro-api:latest
# API_IMAGE=
# WEB_IMAGE=
