# Dependencies & build output
node_modules/
dist/
build/

# Environment - only *.example files are committed
.env
.env.*
!.env*.example

# API runtime data (uploads, generated invoices)
apps/api/uploads/
apps/api/storage/
apps/api/pdf/

# Backups written by apps/api/scripts/backup.sh: password hashes and customer data, never commit
/backups/

# Web
apps/web/app.config.json
apps/web/public/config.json
apps/web/public/CHANGELOG.md

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# Editors & OS
.idea/
.vscode/
.DS_Store
*.log

# Release bundles (scripts/build-bundle.sh)
/bundle/
