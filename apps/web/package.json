{
    "name": "custoro",
    "type": "module",
    "version": "4.0.0",
    "private": true,
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@fontsource/roboto": "^5.3.0",
        "@mui/material": "^9.5.0",
        "@sentry/react": "^11.10.0",
        "@tanstack/react-query": "^5.105.3",
        "@tiptap/pm": "^3.32.2",
        "@tiptap/react": "^3.32.2",
        "@tiptap/starter-kit": "^3.32.2",
        "axios": "^1.21.0",
        "dompurify": "^3.3.2",
        "i18next": "^26.7.1",
        "i18next-http-backend": "^4.0.2",
        "react": "^19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.12",
        "react-markdown": "^10.1.0",
        "react-router": "^8.5.1",
        "react-select": "^5.7.3",
        "zustand": "^5.0.16"
    },
    "scripts": {
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
        "check-all": "npm run format && npm run lint && npm run type-check",
        "playwright": "npx playwright test",
        "playwright-ui": "npx playwright test --ui",
        "predev": "cp ../../CHANGELOG.md public/CHANGELOG.md",
        "dev": "vite",
        "prebuild": "cp ../../CHANGELOG.md public/CHANGELOG.md",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "type-check": "tsc --noEmit"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "description": "Custoro web app",
    "author": "dooker.eu",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.28.8",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "sass": "^1.107.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^5.1.0"
    },
    "allowScripts": {
        "@parcel/watcher": false,
        "fsevents": false
    }
}
