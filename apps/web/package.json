{
    "name": "custoro",
    "type": "module",
    "version": "4.0.0",
    "private": true,
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/material": "^9.4.0",
        "@sentry/react": "^11.4.0",
        "@tanstack/react-query": "^5.104.1",
        "@tiptap/pm": "^3.29.2",
        "@tiptap/react": "^3.29.2",
        "@tiptap/starter-kit": "^3.29.2",
        "axios": "^1.9.0",
        "dompurify": "^3.3.2",
        "i18next": "^26.4.2",
        "i18next-http-backend": "^4.0.2",
        "react": "^19.3.0",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.15",
        "react-markdown": "^10.1.0",
        "react-router": "^8.4.0",
        "react-select": "^5.7.3",
        "zustand": "^5.0.13"
    },
    "scripts": {
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
        "check-all": "npm run format && npm run lint && npm run type-check",
        "playwright": "npx playwright test",
        "playwright-ui": "npx playwright test --ui",
        "predev": "cp ../../CHANGELOG.md public/CHANGELOG.md",
        "dev": "vite",
        "prebuild": "cp ../../CHANGELOG.md public/CHANGELOG.md",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "type-check": "tsc --noEmit"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "description": "Custoro web app",
    "author": "dooker.eu",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.1.2",
        "prettier": "^3.8.1",
        "sass": "^1.105.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.2",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^5.0.3"
    },
    "allowScripts": {
        "@parcel/watcher": false,
        "fsevents": false
    }
}
