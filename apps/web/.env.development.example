# Local development (copy to .env)

# API base URL
VITE_API_ENDPOINT=http://localhost:3999

# Error tracking (optional)
VITE_SENTRY_DSN=

# Playwright end-to-end tests
E2E_API_URL=http://localhost:3999
E2E_WEB_URL=http://localhost:3000
# Demo admin from apps/api/db/demo/demo-logins.md; use a dedicated test account anywhere else
E2E_USER=admin@quantumdesk.example
E2E_PASS=TakeMeToYourLedger!
# A user with the "user" role, for the authorization tests (demo cadet)
E2E_REGULAR_USER=cadet@quantumdesk.example
E2E_REGULAR_PASS=CadetToMars42!
