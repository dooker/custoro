# Production without Docker (copy to .env.production).
# With Docker, use the root .env.production.example instead.

# Database
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=custoro

# Database TLS (see apps/api/config/dbSsl.js). "verify" encrypts and checks the server
# certificate against DB_HOST, which must then be a host name; "off" is plain, for a database on
# the same host or a private network. Defaults: the API "off", production migrations "verify".
# DB_SSL_CA is the CA certificate (PEM) for a server certificate not signed by a public CA.
# DB_SSL=
# DB_SSL_CA=

# Public URL of the web app (used for CORS and to select the database)
APP_ORIGIN=

# Auth - generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Outgoing email sender, e.g. "Custoro <noreply@example.com>" (SMTP settings: .env.email)
EMAIL_FROM=

# Error tracking (optional)
SENTRY_DSN=

# Login and password reset limits (optional). Defaults: 10 failed logins per account and 50 per
# client address in 15 minutes; 3 reset emails per account and 10 per address per hour.
# LOGIN_MAX_FAILURES_PER_ACCOUNT=
# LOGIN_MAX_FAILURES_PER_IP=
# RESET_MAX_REQUESTS_PER_ACCOUNT=
# RESET_MAX_REQUESTS_PER_IP=
# Which proxies may report the client address in X-Forwarded-For (Express "trust proxy").
# The default trusts private-network hops, which fits a TLS proxy on the same host or network.
# If your TLS proxy reaches the server from a public address, set the hop count, e.g. 2.
# TRUST_PROXY=

# API port (default 3999)
SERVICE_PORT=
