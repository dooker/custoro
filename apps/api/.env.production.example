# Production without Docker (copy to .env.production).
# With Docker, use the root .env.production.example instead.

# Database
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=custoro

# Database TLS (see apps/api/config/dbSsl.js). "verify" encrypts and checks the server
# certificate against DB_HOST, which must then be a host name; "off" is plain, for a database on
# the same host or a private network. Defaults: the API "off", production migrations "verify".
# DB_SSL_CA is the CA certificate (PEM) for a server certificate not signed by a public CA.
# DB_SSL=
# DB_SSL_CA=

# Public URL of the web app (used for CORS and for the links in emails)
APP_ORIGIN=

# Auth - generate with: openssl rand -hex 32. The API refuses to start in production with a
# secret shorter than 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Outgoing email sender, e.g. "Custoro <noreply@example.com>" (SMTP settings: .env.email)
EMAIL_FROM=
# The mail server login is only sent over TLS (STARTTLS, or TLS from the start on port 465); the
# connection fails if the server does not offer it. Leave this unset. Only for a mail server or
# test mail catcher on the same machine, "false" allows a plain connection.
# EMAIL_REQUIRE_TLS=

# Error tracking (optional). In production a tenth of the traces are sent; change that with
# SENTRY_TRACES_SAMPLE_RATE (0 to 1).
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=

# Login and password reset limits (optional). Defaults, per 15 minutes: 10 failed logins per
# account from one client address, 50 per account from all addresses together, and 50 per client
# address across accounts; 3 reset emails per account and 10 per address per hour. An IPv6
# client counts as its whole /64.
# LOGIN_MAX_FAILURES_PER_ACCOUNT_ADDRESS=
# LOGIN_MAX_FAILURES_PER_ACCOUNT=
# LOGIN_MAX_FAILURES_PER_IP=
# RESET_MAX_REQUESTS_PER_ACCOUNT=
# RESET_MAX_REQUESTS_PER_IP=
# How many proxies stand between the internet and the API (Express "trust proxy"): 1 = one proxy
# (for example nginx), 2 = two (a TLS proxy and nginx), 0 = none, clients reach the API directly.
# It decides which client address the limits above count. Set it. Unset, every private-network
# hop is trusted, so a client on a private network can forge its address with an
# X-Forwarded-For header and sidestep the per-address limits; the API logs a warning at start.
# A list of addresses or true/false is accepted too.
TRUST_PROXY=

# API port (default 3999)
SERVICE_PORT=
