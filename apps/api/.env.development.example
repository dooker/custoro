# Local development (copy to .env.development)

# Database - matches docker-compose.yml defaults
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=custoro
DB_NAME=custoro

# URL of the web app (used for CORS and for the links in emails)
APP_ORIGIN=http://localhost:3000

# Auth - generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Outgoing email sender, e.g. "Custoro <noreply@example.com>" (SMTP settings: .env.email)
EMAIL_FROM=
# The mail server login is only sent over TLS (STARTTLS, or TLS from the start on port 465). A
# local test mail catcher (MailHog, Mailpit, ...) has no TLS: set false to talk to it in plain text.
# EMAIL_REQUIRE_TLS=false

# Error tracking (optional)
SENTRY_DSN=
