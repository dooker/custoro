{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "typeRoots": ["./types", "./node_modules/@types"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "rootDir": "./",
        "jsx": "react",
        "allowJs": true,
        "resolveJsonModule": true
    },
    "ts-node": {
        "files": true
    },
    "include": ["types", "index.ts", "config", "scripts"],
    "exclude": ["node_modules", "dist"]
}
