{
    "name": "custoro-api",
    "version": "5.0.0-rc.1",
    "description": "Custoro REST API",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "nodemon --watch . --ext ts,tsx --exec \"npm run build && node dist/index.js\"",
        "test": "vitest",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --check .",
        "format": "prettier --write \"**/*.{ts,js,json}\" --ignore-unknown",
        "lint": "eslint \"**/*.{ts,js}\" --fix",
        "migrate:up": "node scripts/migrate.js up",
        "migrate:down": "node scripts/migrate.js down",
        "type-check": "tsc --noEmit",
        "check-all": "npm run format && npm run lint && npm run type-check"
    },
    "keywords": [],
    "author": "dooker.eu",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@react-pdf/renderer": "^4.2.1",
        "@sentry/node": "^11.4.0",
        "@sentry/profiling-node": "^11.4.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "i18next": "^26.7.1",
        "i18next-fs-backend": "^2.6.10",
        "i18next-http-middleware": "^3.10.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.4.0",
        "mysql2": "^3.24.6",
        "nodemailer": "^10.0.14",
        "react": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^24.19.2",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19.2.14",
        "db-migrate": "^0.11.14",
        "db-migrate-mysql": "^3.2.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "allowScripts": {
        "@sentry/node-cpu-profiler": false,
        "ssh2": false,
        "fsevents": false
    }
}
