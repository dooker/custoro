{
    "name": "custoro-api",
    "version": "3.0.5",
    "description": "Custoro REST API",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "nodemon --watch . --ext ts,tsx --exec \"npm run build && node dist/index.js\"",
        "test": "echo \"Error: no test specified\" && exit 1",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --check .",
        "format": "prettier --write \"**/*.{ts,js,json}\" --ignore-unknown",
        "lint": "eslint \"**/*.{ts,js}\" --fix",
        "migrate:up": "node scripts/migrate.js up",
        "migrate:down": "node scripts/migrate.js down",
        "type-check": "tsc --noEmit",
        "check-all": "npm run format && npm run lint && npm run type-check"
    },
    "keywords": [],
    "author": "dooker.eu",
    "license": "MIT",
    "dependencies": {
        "@react-pdf/renderer": "^4.2.1",
        "@sentry/node": "^10.71.0",
        "@sentry/profiling-node": "^10.71.0",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.3.1",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "db-migrate": "^0.11.14",
        "db-migrate-mysql": "^3.0.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.1",
        "express-http-context": "^1.2.4",
        "i18next": "^24.2.2",
        "i18next-fs-backend": "^2.6.0",
        "i18next-http-middleware": "^3.7.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.11.3",
        "node-sessionstorage": "^1.0.0",
        "nodemailer": "^6.10.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sessionstorage-for-nodejs": "^1.0.2",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/nodemailer": "^7.0.11",
        "@types/react": "^19.2.14",
        "cross-env": "^10.1.0",
        "eslint": "^10.0.2",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.3.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.1",
        "typescript-eslint": "^8.56.1"
    }
}
